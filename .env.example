# Postgres
POSTGRES_HOST=localhost
# Host-published port for local Compose and optional production DBeaver access.
POSTGRES_PORT=5432
POSTGRES_DB=nba
POSTGRES_USER=nba_user
POSTGRES_PASSWORD=nba_pass

# Connection string (derived)
DATABASE_URL=postgresql://nba_user:nba_pass@localhost:5432/nba

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
# Tilt / local: browser calls the published API on localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: the prod overlay drives this from PUBLIC_URL (default https://baseline.jyablonski.dev) as a frontend image ARG set at build time — changing .env after the image exists does not retarget the bundle. Do not commit the server .env. API CORS stays localhost for Tilt; the public site is same-origin via Caddy (/api/*).

# NLP /ask backend (FastAPI POST /api/v1/query). Default is the in-house rules engine.
# NLP_BACKEND=llm is opt-in: requires NLP_LLM_API_KEY and still uses Cube tools only (no SQL).
NLP_BACKEND=rules
# NLP_LLM_API_KEY=
# NLP_LLM_BASE_URL=https://api.openai.com/v1
# NLP_LLM_MODEL=gpt-4o-mini

# The Odds API (optional). Forward-looking NBA moneylines/spreads for scrape-odds / daily.
# Unset or empty = skip odds HTTP (same as SLACK_WEBHOOK_URL). Never commit a real key.
# ODDS_API_KEY=

# Scraper Slack (optional). Incoming Webhook; unset/empty = no HTTP, scrape still runs.
# One failure alert per sync (pipeline / scrape-daily / scrape-all / refresh-daily), not per step.
# SLACK_WEBHOOK_URL=
# Consecutive unhealthy runs (failed, or zero rows from a source that always has some) before a
# source alerts. Default 3: one empty night is usually "not published yet".
# SOURCE_ALERT_STREAK=3

# Cube (required for Ask / MCP query governance). Tilt `make up` and the production Compose stack start Cube.
# Host processes (MCP on the workstation) use localhost; compose api/mcp override to http://cube:4000.
# Production Compose keeps Cube internal to the network; port 4000 is not published.
CUBE_API_URL=http://localhost:4000
# Production registry variables for `make prod-refresh` / production Compose jobs.
# Pass these to make explicitly or export them in the server environment.
# IMAGE_PREFIX=ghcr.io/your-owner/
# IMAGE_TAG=latest
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=postgres
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=nba
CUBEJS_DB_USER=nba_user
CUBEJS_DB_PASS=nba_pass
CUBEJS_API_SECRET=your-cube-secret
CUBEJS_DEV_MODE=true

# MCP is stdio by default for local clients. The production overlay switches
# to Streamable HTTP on container port 8000. The port is NOT published: Caddy
# serves MCP at https://<host>/mcp over the site certificate, because clients
# authenticate with a bearer token and that needs TLS.
# Set a separate bearer token before starting production HTTP MCP.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# MCP_API_TOKEN=replace-with-a-long-random-token

# Reddit (PRAW official API — scrape-reddit only; not required for make up / API / scrape-daily)
# Create an app at https://www.reddit.com/prefs/apps (script or confidential web; redirect can be http://localhost)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=nba-analytics/0.1 by zzz
# # Optional: script-app login. Read-only client credentials work without these.
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# --- Admin console (/admin) ---
# All optional. With ADMIN_API_TOKEN unset the admin API returns 503 rather
# than serving operational data publicly, and with ADMIN_GITHUB_LOGINS unset
# the sign-in allowlist is empty so nobody can reach the page. Both fail closed.
#
# Shared secret between the API and the Next.js server. Generate with:
#   openssl rand -hex 32
# ADMIN_API_TOKEN=
#
# Comma-separated GitHub logins allowed into /admin. Usually just you.
# ADMIN_GITHUB_LOGINS=your-github-login
#
# NextAuth session signing key. Generate with: openssl rand -base64 32
# AUTH_SECRET=
#
# GitHub OAuth app credentials. Create at
# https://github.com/settings/developers with the callback URL
# <origin>/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
#
# Public origin NextAuth builds callback URLs from.
# Local: http://localhost:3000   Production: https://baseline.jyablonski.dev
# AUTH_URL=http://localhost:3000
