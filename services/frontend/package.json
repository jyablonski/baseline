{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-timestamps.mjs next dev",
    "build": "next build",
    "start": "node scripts/with-timestamps.mjs next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
